# EmailJS Service Configuration
# Obtain these credentials from https://dashboard.emailjs.com/

# 1. EmailJS Service ID (from Email Services tab, e.g., service_xxxxxxx)
EMAILJS_SERVICE_ID=your_service_id_here

# 2. EmailJS Template ID (from Email Templates tab, e.g., template_xxxxxxx)
EMAILJS_TEMPLATE_ID=your_template_id_here

# 3. EmailJS Public Key (from Account > API Keys > Public Key, e.g., xxxxxxxxxxxxxxx)
# SECURITY NOTICE: ONLY use your Public Key on the client side. NEVER use your Private/Secret Key.
EMAILJS_PUBLIC_KEY=your_public_key_here
